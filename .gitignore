# --- Design docs (D12: kept local, not committed) ---------------------------
# Reversible: delete these lines to publish the design docs.
#
# `docs/*` rather than `docs/`, because git cannot re-include a path whose
# parent DIRECTORY is excluded — the negation below is unreachable otherwise.
docs/*
# D67: milestone logs are the exception. A design doc is a living draft; a
# milestone log is written once at a milestone's close, reports measurements
# taken against a specific commit, and is never edited after. Evidence that
# describes a commit belongs in history with it — the same reason M0 committed
# SPIKE-FINDINGS.md.
!docs/milestone-logs/

# --- Spike artifacts --------------------------------------------------------
# fixtures/ excluded: ~45 MB of re-downloadable arXiv PDFs.
# results/ IS committed — the JSON files are the evidence behind SPIKE-FINDINGS.md.
spike/fixtures/
spike/.venv/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Local object store -----------------------------------------------------
# OBJECT_STORE_PATH defaults to ./var/objects: uploaded PDFs and the canonical
# parsed text. User content, and rebuildable — never committed.
var/

# --- Models / data caches ---------------------------------------------------
models/
.cache/
*.gguf
*.onnx

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- Editors / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
