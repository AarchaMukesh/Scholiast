# Scholiast — local development configuration.
#
#   copy .env.example .env
#
# The defaults match docker-compose.yml, so an unedited copy works for the
# backing services. The only value you must supply is a generation provider —
# see the bottom section.

# --- Backing services (match docker-compose.yml) -----------------------------
POSTGRES_USER=scholiast
POSTGRES_PASSWORD=scholiast
POSTGRES_DB=scholiast
POSTGRES_PORT=5432

# The API and worker run natively on Windows (CLAUDE.md dev topology), so they
# reach the containers over published localhost ports.
DATABASE_URL=postgresql+asyncpg://scholiast:scholiast@localhost:5432/scholiast

QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

GROBID_PORT=8070
GROBID_URL=http://localhost:8070

# --- Storage -----------------------------------------------------------------
# Local filesystem in dev, S3-compatible in prod, both behind one ObjectStore
# port (doc 7 §7.3). Holds the original PDF and the retained GROBID TEI (D43),
# keyed by paper id so each paper owns its bytes outright (D49). The canonical
# parsed text that chunk offsets index is NOT here — D42 moved it to
# `sections.text`, so resolving a citation touches one store, not two.
OBJECT_STORE_PATH=./var/objects

# --- Ingestion worker ---------------------------------------------------------
# The M1 queue is `ingestion_jobs` claimed with FOR UPDATE SKIP LOCKED (D47), so
# there is no broker to push work and the loop polls. Celery replaces it in M3.
WORKER_POLL_SECONDS=1.0
# Visibility timeout: a crashed worker's job becomes claimable again this long
# after its last stage transition. Well above the slowest stage, because a live
# worker refreshes it at every transition and only a dead one should lose it.
WORKER_LEASE_SECONDS=300
WORKER_BATCH_SIZE=1
# D63: the API process runs the worker, so `uvicorn scholiast.main:app` is the
# single command M1's acceptance criterion asks for. M3 turns this off when
# Celery takes the worker over — a configuration change, not a restructuring.
WORKER_IN_PROCESS=true

# --- Task queue (M3 phase 3, D95) --------------------------------------------
# False keeps M1's topology: one process, the worker polling the same database
# it writes to, and no broker round trip to buy anything. True moves ingestion
# into a Celery worker — set WORKER_IN_PROCESS=false alongside it, or the job
# gets claimed twice over by two pollers.
#
#   celery -A scholiast.workers.tasks worker -Q ingest,maintenance -c 1 --loglevel=info
#   celery -A scholiast.workers.tasks beat --loglevel=info
#
# Beat is the scheduler for the reconciliation sweep (M3 phase 5, D100). Run
# EXACTLY ONE of it however many workers there are: a second beat does not
# share the schedule, it duplicates it, so every sweep would run twice.
# It runs natively next to the worker because compose has no image holding
# Scholiast — containerising the app is M6's work.
#
# One worker consuming both queues means a long cascade occupies the slot an
# upload wants (worker_prefetch_multiplier=1). Giving maintenance its own
# worker is a deployment change, not a code change: -Q ingest and -Q
# maintenance on two processes.
#
# The worker runs NATIVELY rather than in a container, for the same reason the
# API does: direct GPU access (CLAUDE.md dev topology).
#
# D95: Celery is the transport, not the source of truth. The job row is written
# in the same transaction as the paper and the membership, and the dispatch is a
# wake-up sent after that commit — so a broker that is down costs latency, not
# work, because the lease makes an unclaimed job claimable again.
CELERY_ENABLED=false

# --- Maintenance sweep (M3 phase 5, D100, D102) -------------------------------
# How often the reconciliation sweep runs, in seconds. It finds cascades whose
# dispatch was lost, papers no workspace holds, vectors with no chunk row, and
# blobs with no paper. Shorter converges faster and scans more: every pass
# walks the whole index and object store whether or not there is residue.
RECONCILE_INTERVAL_SECONDS=300

# --- Authentication (M3 phase 1, D84) ----------------------------------------
# HMAC key for access tokens. The adapter refuses anything under 32 characters
# at startup, so a misconfigured deployment fails to boot rather than failing
# open — but the DEFAULT in settings.py is a well-known development key, which
# means an unedited deployment is signing tokens anyone can forge. M6's release
# checklist treats an unset JWT_SECRET as a blocker, not a warning.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
# Goes into every token's `iss` and is required on the way back in, so a token
# minted by another service sharing the secret is still rejected.
JWT_ISSUER=scholiast
# Nothing can revoke an access token before it expires (D84), so this number IS
# the revocation latency. Refresh tokens are revocable — rotated on every use,
# whole family revoked on reuse — which is what makes a long life safe there.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Read by migration 0005 at upgrade time, NOT by the application. D85 gave the
# M1 seed user (demo@scholiast.local) a real password instead of deleting the
# row, because `workspaces.owner_id` cascades and dropping it would take every
# workspace, paper and chunk in an existing database with it. Set this before
# first upgrade, or accept the documented default below. A real deployment sets
# it or deletes the row.
SEED_USER_PASSWORD=scholiast-dev-password

# --- Local inference ---------------------------------------------------------
# fp16 on GPU is specified, not preferred (D18): fp32 reranking is 3.3× slower
# and consumes ~93% of NFR-P2's whole-stage budget on its own.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_PRECISION=fp16

# --- Generation --------------------------------------------------------------
# D26 inverts the obvious ordering. Groq's free tier is ~12,000 tokens/minute,
# which is roughly **2 RAG requests per minute** — unusable as the development
# default. The local 3B runs at 125 tok/s fully GPU-resident with no quota, so
# it carries sustained load and hosted quota becomes a deliberate spend.
#
# Ollama placement is sticky within keep_alive (D23): one `num_gpu: 0` request
# pins the model to CPU for every later request. The adapter reads actual
# placement rather than assuming it.
GENERATION_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq is the preferred *hosted* provider on data-terms grounds (D29): its
# Services Agreement prohibits training on Inputs/Outputs. Google's free tier
# explicitly trains on submitted content and permits human review, which is
# disqualifying for a system that ingests possibly-unpublished manuscripts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Rate limiting and the ops surface (M3 phase 8, NFR-SEC7, D112-D114) ------
# IN-PROCESS and fixed-window (D112). The limit is per API process, so it is a
# real number today (one process) and weaker the moment a deployment scales out
# — said here rather than implied away. Not Redis-backed: that would reverse
# D104 and make LOGIN depend on Redis, where failing closed is an outage and
# failing open is not a control.
RATE_LIMIT_ENABLED=true
# Login, register and refresh, keyed by SOCKET PEER. `X-Forwarded-For` is never
# read (D113): nothing sits in front of the app, so honouring it would let any
# caller mint a fresh bucket per forged value. Under a future proxy this fails
# CLOSED — every anonymous caller shares the proxy's bucket, which is too strict
# and says so. A deployment adding a proxy must add trusted-proxy handling in the
# same change.
RATE_LIMIT_AUTH_PER_MINUTE=10
# The QA path and uploads, keyed by USER. QA is the most expensive endpoint in the
# system (retrieval plus generation); an upload costs a GROBID parse and an
# embedding pass.
RATE_LIMIT_QA_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
# Discovery searches, keyed by USER (D122). Each spends an OpenAlex search from an
# allowance of about 1,000 a day shared by EVERY user, and an arXiv request at
# arXiv's pace. One user at this limit would spend the day's OpenAlex allowance in
# under two hours.
RATE_LIMIT_DISCOVERY_PER_MINUTE=10
# Adding discovered papers, keyed by USER and counted per PAPER, not per request
# (D133): each paper costs a lookup share, a paced fetch, a parse and an embedding
# pass. At least 10, one full batch, or a full batch could never be accepted.
RATE_LIMIT_ADD_PER_MINUTE=20
#
# Closes D110. When set, /metrics and /health/ready require this as a bearer
# token; empty leaves them open, which is the development default. A static token
# rather than a JWT because a scraper polls forever and cannot refresh something
# that expires. /health/live is NEVER gated: an orchestrator's restart decision
# must not need a credential.
#
# Stated limitation: a shared secret with no rotation story that travels on every
# scrape. A second bind port is stronger and needs M6.
METRICS_TOKEN=
#
# NOT implemented, and said plainly: the SSRF allowlist doc 8 lists under M3
# (D115). No endpoint accepts a URL — uploads are multipart, every outbound call
# goes to a configured host. It becomes real in M4, where discovery dereferences
# URLs that come from third-party API responses, and it is recorded as that
# milestone's precondition rather than built with no caller.

# --- Observability (M3 phase 7, FR-O1, D107-D111) -----------------------------
# JSON because the consumer is a collector, not a terminal. `false` switches to
# structlog's console renderer for local work — a format choice, not a different
# logging system. Uvicorn's and SQLAlchemy's records go through the same renderer,
# because a stream that is JSON for our lines and plain text for the framework's
# is two streams sharing a file descriptor rather than a structured log.
LOG_JSON=true
LOG_LEVEL=INFO
#
# Correlation ids: the API mints one per request (or reuses a safe inbound
# X-Request-ID) and stamps it on the job row, so a worker log line joins to the
# request that accepted the paper. On the ROW and not the Celery message,
# because under D95 the message is a wake-up and the claim decides what actually
# runs — a header-borne id would label a run with another paper's request id.
#
# /metrics and /health/ready are UNAUTHENTICATED (D110). No metric label carries
# a workspace id, paper id, email or question — route templates only, which is
# both a privacy property and a cardinality one. Restricting them is phase 8's:
# the options are a static scrape token, a second bind port, or network policy,
# and choosing needs a deployment (M6).
#
# Not implemented, and said plainly: FR-O4 distributed tracing (D109). Priority
# S, no collector in the dev topology, and the latency breakdown §5.12 wanted it
# for is already emitted as per-stage timings.

# --- Provider circuit breaker (M3 phase 6, D103, D104) ------------------------
# Every rung of the chain, local included, sits behind a breaker. What it buys is
# LATENCY on the ladder, not fewer failures: without it an unreachable provider
# costs its full timeout (60 s for Groq) on every question before the chain moves
# on, so one dead provider makes every answer slow instead of making one fail.
#
# Consecutive failures before a provider is skipped without being dialled. A
# success resets the count, so this measures an outage rather than lifetime
# errors.
BREAKER_FAILURE_THRESHOLD=3
# How long to skip it when the provider said nothing about when to return. A
# 429's `Retry-After` OVERRIDES this: the provider has stated the answer and this
# number can only guess at it (D103). No token bucket is built — Groq meters
# tokens and a token count is not known until after the call, so a bucket would
# either limit the wrong quantity or limit the right one with a guess.
#
# After the window one probe request decides whether to close or re-open, which
# is what stops a recovered provider staying locked out for the full cooldown.
BREAKER_COOLDOWN_SECONDS=30

# --- Discovery (M4 phase 3, D122-D125) ------------------------------------------
# OpenAlex requires a key beyond a test allowance (D116). Empty means OpenAlex is
# ABSENT, not broken: discovery runs on arXiv alone. The key travels only in an
# Authorization header, never in a URL a log could record.
OPENALEX_API_KEY=
# The sources' share of NFR-P1's 3.0 s; the remaining 1.0 s is for dedup, ranking
# and the response (D122). Every source is cut off at the same moment, and a source
# still working then is reported `timeout` while the others' results are returned.
DISCOVERY_DEADLINE_SECONDS=2.0
# Measured, not chosen: at 25 results addendum A2 found p95 1.58 s against the
# 2.0 s deadline (D125). Raising it is a latency decision, not a quality one.
DISCOVERY_OPENALEX_PAGE_SIZE=25
DISCOVERY_ARXIV_PAGE_SIZE=50
# arXiv's API terms: one request every three seconds. Validated to be at least 3,
# because the floor is arXiv's. A search never WAITS for the slot: if it is taken,
# arXiv is reported `rate_limited` for that search (D123). PER PROCESS: a deployment
# that runs a second API process must share the pacer in the same change.
DISCOVERY_ARXIV_MIN_GAP_SECONDS=3.0
# The cache (D127, D128): each source's page, PER USER, for a day. Its own Redis,
# `redis-cache` in compose: capped and evicting, so it can never crowd out the
# Celery broker on REDIS_URL. Down or unreachable, discovery simply runs uncached.
# Failures are never cached, so a source that failed is asked again next time.
DISCOVERY_CACHE_URL=redis://localhost:6380/0
REDIS_CACHE_PORT=6380
DISCOVERY_CACHE_TTL_SECONDS=86400
# Bounds one Redis call; after three failures the cache's breaker stops calling.
DISCOVERY_CACHE_TIMEOUT_SECONDS=0.25

# --- Fetching open-access PDFs (M4 phase 5, D115, D129, D130) -------------------
# Every link comes from a third party's record, so every hop is checked: https only
# (http is upgraded), port 443, no credentials in the URL, no IP-literal host, the
# host EXACTLY on this list, and every resolved address public. The connection goes
# to the address that was checked. www.aclweb.org is here only because ACL papers
# reach aclanthology.org through it; a host that only redirects must be listed too.
# Measured: these three fetch 74% of discovered papers (D130). Adding a host is a
# decision with evidence, not a convenience.
FETCH_ALLOWED_HOSTS=["arxiv.org","aclanthology.org","www.aclweb.org"]
# arXiv's robots.txt Crawl-delay; validated to be at least 15. The fetcher WAITS
# for its slot: it runs in the worker, where waiting costs no user any latency.
FETCH_ARXIV_MIN_GAP_SECONDS=15
FETCH_MIN_GAP_SECONDS=5
FETCH_TOTAL_TIMEOUT_SECONDS=60

# ON whenever any provider in the chain may train on submitted content (D30).
# With a Groq-only or local-only chain the constraint relaxes; the flag stays
# because the provider mix can change.
PRIVATE_PAPERS_LOCAL_ONLY=true
