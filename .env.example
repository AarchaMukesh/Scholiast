# Scholiast — local development configuration.
#
#   copy .env.example .env
#
# The defaults match docker-compose.yml, so an unedited copy works for the
# backing services. The only value you must supply is a generation provider —
# see the bottom section.

# --- Backing services (match docker-compose.yml) -----------------------------
POSTGRES_USER=scholiast
POSTGRES_PASSWORD=scholiast
POSTGRES_DB=scholiast
POSTGRES_PORT=5432

# The API and worker run natively on Windows (CLAUDE.md dev topology), so they
# reach the containers over published localhost ports.
DATABASE_URL=postgresql+asyncpg://scholiast:scholiast@localhost:5432/scholiast

QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

GROBID_PORT=8070
GROBID_URL=http://localhost:8070

# --- Storage -----------------------------------------------------------------
# Local filesystem in dev, S3-compatible in prod, both behind one ObjectStore
# port (doc 7 §7.3). Holds the original PDF and the retained GROBID TEI (D43),
# keyed by paper id so each paper owns its bytes outright (D49). The canonical
# parsed text that chunk offsets index is NOT here — D42 moved it to
# `sections.text`, so resolving a citation touches one store, not two.
OBJECT_STORE_PATH=./var/objects

# --- Ingestion worker ---------------------------------------------------------
# The M1 queue is `ingestion_jobs` claimed with FOR UPDATE SKIP LOCKED (D47), so
# there is no broker to push work and the loop polls. Celery replaces it in M3.
WORKER_POLL_SECONDS=1.0
# Visibility timeout: a crashed worker's job becomes claimable again this long
# after its last stage transition. Well above the slowest stage, because a live
# worker refreshes it at every transition and only a dead one should lose it.
WORKER_LEASE_SECONDS=300
WORKER_BATCH_SIZE=1

# --- Local inference ---------------------------------------------------------
# fp16 on GPU is specified, not preferred (D18): fp32 reranking is 3.3× slower
# and consumes ~93% of NFR-P2's whole-stage budget on its own.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_PRECISION=fp16

# --- Generation --------------------------------------------------------------
# D26 inverts the obvious ordering. Groq's free tier is ~12,000 tokens/minute,
# which is roughly **2 RAG requests per minute** — unusable as the development
# default. The local 3B runs at 125 tok/s fully GPU-resident with no quota, so
# it carries sustained load and hosted quota becomes a deliberate spend.
#
# Ollama placement is sticky within keep_alive (D23): one `num_gpu: 0` request
# pins the model to CPU for every later request. The adapter reads actual
# placement rather than assuming it.
GENERATION_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq is the preferred *hosted* provider on data-terms grounds (D29): its
# Services Agreement prohibits training on Inputs/Outputs. Google's free tier
# explicitly trains on submitted content and permits human review, which is
# disqualifying for a system that ingests possibly-unpublished manuscripts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ON whenever any provider in the chain may train on submitted content (D30).
# With a Groq-only or local-only chain the constraint relaxes; the flag stays
# because the provider mix can change.
PRIVATE_PAPERS_LOCAL_ONLY=true
